{"notebook":"nb1","page":6,"seed":6,"says":"Shadows move. I wish I had thought of it. So the pencil stands on end in a lump of putty and becomes a sundial: its 8:20 shadow drawn solid and rubbed out, the 9:10 shadow drawn and rubbed out, and the 10:05 one left standing, with the two ghosts still visible in the scuffed paper. You call that billing the same paper twice; I call it the only honest way to draw a morning. Underneath goes the desk I owed you: grain across the whole page, a knot, and the ring the mug left. Tone spread sideways, as asked.","before":{"length":154.82153583847085,"worn":0.03523522323182059,"eraser":11.811767559553337,"sharpenings":7,"graphite":6.060334463201302,"distance":116361.62128564101},"after":{"length":151.8616124626031,"worn":0.025951237688292765,"eraser":10.898879256580623,"sharpenings":8,"graphite":6.699051341555869,"distance":133870.8905328485},"stats":{"strokeM":17.509269247202806,"graphite":0.6387168783546061,"used":2.95992337586776,"sharpenings":1,"erasedMm2":7635,"coverage":0.012191860632360553,"stopped":false},"warnings":[],"ops":[{"op":"write","text":"10:05. Sun on the desk.","x":14,"y":22,"size":7},{"op":"curve","points":[[14,37.72],[20,38.13],[26,38.54],[32,38.91],[38,39.22],[44,39.44],[50,39.57],[56,39.59],[62,39.51],[68,39.32],[74,39.04],[80,38.7],[86,38.3],[92,37.88],[98,37.48],[104,37.1],[110,36.79],[116,36.56],[122,36.43],[128,36.4],[134,36.48]],"pressure":0.6},{"op":"curve","points":[[14,42.23],[20,42.48],[26,42.64],[32,42.7],[38,42.65],[44,42.49],[50,42.24],[56,41.91],[62,41.53],[68,41.12],[74,40.7],[80,40.32],[86,39.98],[92,39.73],[98,39.56],[104,39.5],[110,39.55],[116,39.7],[122,39.95],[128,40.27],[134,40.65]],"pressure":0.6874999999999986},{"op":"curve","points":[[14,45.78],[20,45.65],[26,45.43],[32,45.12],[38,44.75],[44,44.35],[50,43.93],[56,43.53],[62,43.18],[68,42.9],[74,42.7],[80,42.61],[86,42.62],[92,42.74],[98,42.96],[104,43.26],[110,43.63],[116,44.03],[122,44.45],[128,44.85],[134,45.2]],"pressure":0.400000000