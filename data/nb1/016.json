{"notebook":"nb1","page":16,"seed":16,"says":"It is a brush, so I am using it as one, and for something I owe you twice over. Pages ago you said a coat has underfur and that the cat floats in nothing. So: the lamp goes off, and the blunt point is dragged broad and hard across the whole sheet, room and underfur in one coat, until it gives out. The cat goes in on top of that, blacker than the dark. Then the eraser finds her: two eyes and a bib, nothing else. Only then do I sharpen, for pupils and whiskers. What matters first: she does.","before":{"length":109.45689327205642,"worn":1.5021044856554446,"eraser":9.164151984326503,"sharpenings":23,"graphite":17.817157288916793,"distance":443380.642694605},"after":{"length":103.55176258039906,"worn":0.026234191590962613,"eraser":9.09255869294569,"sharpenings":25,"graphite":21.08310340875391,"distance":494462.6820555244},"stats":{"strokeM":51.08203936082098,"graphite":3.2659461198369386,"used":5.905130691657362,"sharpenings":2,"erasedMm2":393,"coverage":0.14640618168226555,"stopped":false},"warnings":[],"ops":[{"op":"hatch","region":{"rect":[14,32,120,138]},"angle":12,"spacing":1.5,"pressure":1},{"op":"hatch","region":{"rect":[14,32,120,138]},"angle":-55,"spacing":1.7,"pressure":0.8},{"op":"hatch","region":{"polygon":[[51,82],[52,70],[54,54],[66,65],[74,63],[82,65],[94,54],[96,70],[97,82],[93,94],[88,100],[98,118],[104,140],[104,150],[120,150],[126,156],[120,162],[100,164],[48,164],[44,150],[46,128],[56,104],[55,94]]},"angle":80,"spacing":0.35,"cross":true,"pressure":1.5},{"op":"erase","x":64,"y":80,"w":2,"h":2},{"op":"erase","x":82,"y":80,"w":2,"h":2},{"op":"erase","x":73.73063244149151,"y":106.5,"w":0.5387351170169774,"h":1},{"op":"erase","x":72.90325050069893,"y":108,"w":2.1934989986021227,"h":1},{"op":"erase","x":72.19912691540583,"y":109.5,"w":3.601746169188324,"h":1},{"op":"erase","x":71.65044454694734,"y":111,"w":4.699110906105299,"h":1},{"op":"erase","x":71.28228161873476,"y":112.5,"w":5.435436762530478,"h":1},{"op":