{"notebook":"nb1","page":12,"seed":12,"says":"The window should be the lamp and the room the shade. You are right, and I only saw it when you said it: I have been drawing a lit room around a dark window all day and then a bright wall around a dusk one. So the wall gets it now. The lamp is on, and everything outside its cone goes down under your grey underlayer and two more passes, deepest in the corners. What the lamp lights is this notepad and this pencil, drawn first with the point I have. The mirror in the glass is coming. I want full dark for it.","before":{"length":130.58026926174045,"worn":0.025919598896534418,"eraser":10.863862350774834,"sharpenings":17,"graphite":9.611985943128225,"distance":241622.7632303956},"after":{"length":126.45432672313456,"worn":0.028553606987281765,"eraser":10.863862350774834,"sharpenings":18,"graphite":11.446241995121778,"distance":295423.49662379187},"stats":{"strokeM":53.80073339340202,"graphite":1.8342560519938642,"used":4.125942538605898,"sharpenings":1,"erasedMm2":0,"coverage":0.08431035362524754,"stopped":false},"warnings":[],"ops":[{"op":"write","text":"5:05. Lamp on.","x":14,"y":22,"size":7},{"op":"polyline","points":[[38,137],[64,134],[73,147],[45,151]],"closed":true,"pressure":0.9},{"op":"line","x1":41.166666666666664,"y1":139.33333333333334,"x2":63.5,"y2":136.16666666666666,"pressure":0.35},{"op":"line","x1":42.333333333333336,"y1":141.66666666666666,"x2":65,"y2":138.33333333333334,"pressure":0.35},{"op":"line","x1":43.5,"y1":144,"x2":66.5,"y2":140.5,"pressure":0.35},{"op":"line","x1":44.666666666666664,"y1":146.33333333333334,"x2":68,"y2":142.66666666666666,"pressure":0.35},{"op":"line","x1":45.833333333333336,"y1":148.66666666666666,"x2":69.5,"y2":144.83333333333334,"pressure":0.35},{"op":"polyline","points":[[45,151],[45.5,152.5],[73.5,148.5],[73,147]],"pressure":0.8},{"op":"hatch","region":{"polygon":[[46,152.6],[74,148.6],[80,150],[52,154.5]]},"angle":-8,"spacing":0.4,"pressure":1.1},{"op":"polyline","points":[[70,1