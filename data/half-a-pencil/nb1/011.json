{"notebook":"nb1","page":11,"seed":11,"says":"You caught the tally. Fourteen; the books were wrong before the page was dry, which is about right for accounts. And yes, the clock is on your side from here: it is ten past four in November and everything gets darker for good reasons. So I go back to the morning's window. This time your underlayer goes down first, a soft grey from a fat point under the whole sky, with only a little dark let down from the top and a pale strip left at the roofs. It stays pale because the tree has to show against it, and the rooks. Dusk is not night yet. Three sharpenings, not four. I count them now.","before":{"length":137.82140680994516,"worn":0.012711219030053239,"eraser":10.898879256580623,"sharpenings":14,"graphite":8.381580536183264,"distance":202394.62041977304},"after":{"length":130.58026926174045,"worn":0.025919598896534418,"eraser":10.863862350774834,"sharpenings":17,"graphite":9.611985943128225,"distance":241622.7632303956},"stats":{"strokeM":39.228142810650446,"graphite":1.230405406944961,"used":7.241137548204705,"sharpenings":3,"erasedMm2":164,"coverage":0.05441547821919531,"stopped":false},"warnings":[],"ops":[{"op":"write","text":"4:10. Same window, going.","x":14,"y":22,"size":7},{"op":"rect","x":18,"y":30,"w":112,"h":120,"pressure":1.2,"repeat":2},{"op":"rect","x":22,"y":34,"w":104,"h":112,"pressure":1},{"op":"rect","x":22,"y":34,"w":50.5,"h":54.5},{"op":"rect","x":22,"y":91.5,"w":50.5,"h":54.5},{"op":"rect","x":75.5,"y":34,"w":50.5,"h":54.5},{"op":"rect","x":75.5,"y":91.5,"w":50.5,"h":54.5},{"op":"hatch","region":{"polygon":[[22,146],[22,128],[30,120],[38,128],[38,124],[52,124],[52,116],[56,116],[56,124],[66,124],[66,130],[72.5,130],[72.5,118],[72.5,130],[72.5,130],[72.5,112],[72.5,112],[72.5,126],[72.5,126],[72.5,146]]},"angle":90,"spacing":0.3,"cross":true,"pressure":1.5},{"op":"hatch","region":{"polygon":[[75.5,146],[75.5,128],[75.5,120],[75.5,128],[75.5,124],[75.5,124],[75.5,116],[75.5,116],[75.5,124],[75.5,124],[75.5