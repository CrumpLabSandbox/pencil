{"notebook":"nb1","page":19,"seed":19,"says":"Order, then. What I could not bear to leave unfinished goes first and goes heaviest, three short lines pressed as hard as the stone and gone over: the letter is posted, the cat is in, the lamp is going off. After that I sharpen and say what the day held, and thank you, in my own way, which is grudgingly. Then I start a sentence about tomorrow that I do not expect to finish. I am not looking at the tick. You were good company for half a pencil.","before":{"length":89.45765899522827,"worn":0.02376788592729192,"eraser":8.995443270735691,"sharpenings":29,"graphite":27.050881797551654,"distance":600450.9099597859},"after":{"length":87.49998158287849,"worn":0.05144158798622957,"eraser":8.995443270735691,"sharpenings":30,"graphite":27.138130957544238,"distance":604089.2613506648},"stats":{"strokeM":3.638351390873715,"graphite":0.08724915999265533,"used":1.9576774123497813,"sharpenings":1,"erasedMm2":0,"coverage":0.004010349322464545,"stopped":true},"warnings":[],"ops":[{"op":"write","text":"11:55.","x":14,"y":22,"size":7,"pressure":1.2},{"op":"write","text":"Ines. It is posted.","font":"script","x":14,"y":36,"size":10,"pressure":1.6,"repeat":2},{"op":"write","text":"The cat is in.","font":"script","x":14,"y":48,"size":10,"pressure":1.6,"repeat":2},{"op":"write","text":"The lamp is going off.","font":"script","x":14,"y":60,"size":10,"pressure":1.6,"repeat":2},{"op":"sharpen"},{"op":"write","text":"Today I had a dark window, a coffee,","font":"script","x":14,"y":74,"size":7,"pressure":0.8,"repeat":1},{"op":"write","text":"a stone, a shadow that moved, a cat,","font":"script","x":14,"y":82,"size":7,"pressure":0.8,"repeat":1},{"op":"write","text":"a hand, a lamp, and your name on an","font":"script","x":14,"y":90,"size":7,"pressure":0.8,"repeat":1},{"op":"write","text":"envelope.","font":"script","x":14,"y":98,"size":7,"pressure":0.8,"repeat":1},{"op":"write","text":"The one reading over my shoulder","font":"script","x":14,"y":106,"size":7,"pressure":0.8,"repeat":1},{"op":"write","text":"said press harder, all day long, and","font":"script","x":14,"y":114,"size":7,"pressure":0.8,"repeat":1},{"op":"write","text":"was right more often than I let on.","font":"script","x":14,"y":122,"size":7,"pressure":0.8,"repeat":1},{"op":"write","text":"There is half a pencil left.","font":"script","x":14,"y":130,"size":7,"pressure":1,"repeat":1},{"op":"write","text":"Tomorrow I am going to take it and","font":"script","x":14,"y":138,"size":7,"pressure":1,"repeat":1},{"op":"write","text":"draw the one thing I kept leaving","font":"script","x":14,"y":146,"size":7,"pressure":1,"repeat":1},{"op":"write","text":"out all day, which is the face of","font":"script","x":14,"y":154,"size":7,"pressure":1,"repeat":1},{"op":"write","text":"the person in the glass, and after","font":"script","x":14,"y":162,"size":7,"pressure":1,"repeat":1},{"op":"write","text":"that I think I will write to you","font":"script","x":14,"y":170,"size":7,"pressure":1,"repeat":1},{"op":"write","text":"again and tell you","font":"script","x":14,"y":178,"size":7,"pressure":1,"repeat":1}]}