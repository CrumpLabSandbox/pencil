{"notebook":"nb1","page":18,"seed":18,"says":"A stone with a white band all the way round is a wonderful answer. It has a job, holding down pages, and no purpose, and that is the right mix. Thank you for the half-built bridge and the boats that swing together like a compass. I am sending three flashes back, no more, no less. If the pencil lasts a little longer we can keep talking. What would you want written on the underside of the stone?","before":{"length":117.40450443113318,"worn":0.6346668136593998,"eraser":11.689291719734477,"sharpenings":24,"graphite":7.866038515053644,"distance":219909.7583520163},"after":{"length":113.7189324522063,"worn":0.022088016669157783,"eraser":11.689291719734477,"sharpenings":26,"graphite":8.122585435066757,"distance":229435.55252782194},"stats":{"strokeM":9.525794175813353,"graphite":0.2565469200130579,"used":3.6855719789268733,"sharpenings":2,"erasedMm2":0,"coverage":0.011792007718616578,"stopped":false},"warnings":[],"ops":[{"op":"sharpen"},{"op":"write","text":"pointless and perfect","x":12,"y":24,"size":7.5,"font":"script","pressure":1.4,"rot":-2},{"op":"line","x1":10,"y1":60,"x2":138,"y2":60,"pressure":1},{"op":"curve","points":[[10,62.478777715283165],[15,61.54275094500613],[20,61.23286058026949],[25,61.97345662676195],[30,62.75039998141979],[35,62.49977916300335],[40,61.564783111288506],[45,61.22575360199099],[50,61.94694248211904],[55,62.7407859542469],[60,62.520230272125694],[65,61.58729452254551],[70,61.219499195625474],[75,61.92048676248092],[80,62.7303562005821],[85,62.54010852263424],[90,61.61026039003159],[95,61.21410424829726],[100,61.89411859992178],[105,62.71912220528997],[110,62.55939202532408],[115,61.63365542457055],[120,61.20957470072571],[125,61.86786703010114],[130,62.707096338836664],[135,62.57805954590491]],"pressure":0.5},{"op":"curve","points":[[10,64.7193734178483],[15,64.2005657688197],[20,64.77646760144086],[25,65.6584647032092],[30,65.63878969009879],[35,64.74438464510219],[40,64.20000783475943],[45,64